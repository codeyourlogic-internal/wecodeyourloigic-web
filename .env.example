# Web3Forms access key (required for /contact and /careers)
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Optional — Google Search Console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics / marketing (leave blank until you have real IDs)
# Prefer GTM for production: put GA4 + Ads tags in the container, leave GA empty
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_META_PIXEL_ID=

# Cookie consent policy (default: geo)
#   geo   = banner only in EEA/UK/CH; track immediately elsewhere
#   true  = always show banner
#   false = never show banner
# NEXT_PUBLIC_REQUIRE_COOKIE_CONSENT=geo
